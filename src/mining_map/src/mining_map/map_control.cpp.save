// Function to send a command to the Arduino
void sendCommand(unsigned int command) {
    if (serial_port.isOpen()) {
        std::ostringstream command_stream;
        command_stream << "$" << command << "\n";
        serial_port.write(command_stream.str());
        ROS_INFO_STREAM("Sent command: " << command_stream.str());
    } else {
        ROS_WARN("Serial port not open.");
    }
}


void dest_action_0(bool& started, bool& done){
	static ros::Time timer;
	if (!started && !done){
		started = true;
		timer = ros::Time::now();
	}
	ros::Duration count_down = ros::Time::now() - timer;
	if (count_down.toSec() >= 5.0) {
		done = true;
	}
}
