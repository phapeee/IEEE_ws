#include <ros/ros.h>
#include <std_msgs/Float64MultiArray.h>
#include <geometry_msgs/Vector3.h>
#include <nav_msgs/Odometry.h>
#include <cmath>
#include <math.h>
#include <mecanum_ik/i2c_reader.h>
#include <wiringPi.h>
#include <std_srvs/Empty.h>  // Include the service header

#define WHEEL_RADIUS	(2.95275591 / 2)
#define VD_HD		(8.7)
#define MOTOR_1_ADD	(0x10)
#define MOTOR_2_ADD	(0x11)
#define MOTOR_3_ADD	(0x12)
#define MOTOR_4_ADD	(0x13)
#define SAMPLING_PERIOD	(0.010) // second
#define COEFF_R		(WHEEL_RADIUS/4)
#define COEFF_M		(1/VD_HD)
#define INIT_X		(31.25)
#define INIT_Y		(6)
#define INIT_THETA	(M_PI_2)
#define M_2PI           (2 * M_PI)
#define RESET_PID_PIN	(16)
#define RPS_TO_RPM	(60 / (2 * M_PI))
#define COEFF		(RPS_TO_RPM / WHEEL_RADIUS)

ros::Publisher wheel_pub;
nav_msgs::Odometry pose_est;

I2CReader motor_1(MOTOR_1_ADD);
I2CReader motor_2(MOTOR_2_ADD);
I2CReader motor_3(MOTOR_3_ADD);
I2CReader motor_4(MOTOR_4_ADD);


double angle = INIT_THETA;
bool reading = false;
bool sending = false;
bool shutdown_wheel = false;
float desired_spd[4];

void resetWheel(){
	digitalWrite(RESET_PID_PIN, LOW);
        ros::Duration(0.2).sleep();
        digitalWrite(RESET_PID_PIN, HIGH);
        ros::Duration(2).sleep();

	motor_1.sendDesiredSpeed(0);
	motor_2.sendDesiredSpeed(0);
	motor_3.sendDesiredSpeed(0);
	motor_4.sendDesiredSpeed(0);
}


// calculate the local speed of bot with given 3D vector velocity in which x and y components are desired local linear velocities and z component desried rotaiional velocity
//     | 1 -1 -(l+w) | |x|
// 1/r*| 1  1  (l+w) |*|y|
//     | 1 -1  (l+w) | |z|
//     | 1  1 -(l+w) |
// return value is a 4D vector in which x is top left, y is top right, z is bottom right, w is bottom left
void inverse_kinematic_callback(const geometry_msgs::Vector3::ConstPtr &bot_vel)
{
	double div_x = bot_vel->x * ;
	double div_y = bot_vel->y * COEFF;
	double mul_z = VD_HD * bot_vel->z * COEFF;

	if (!motor_1.sendDesiredSpeed(div_x - div_y - mul_z) ||
	    !motor_2.sendDesiredSpeed(div_x + div_y - mul_z) ||
	    !motor_3.sendDesiredSpeed(div_x - div_y + mul_z) ||
	    !motor_4.sendDesiredSpeed(div_x + div_y + mul_z)
	) resetWheel();


//	ROS_INFO("%2.f", desired_spd[0]);
}

void publishPose()
{
	double wheel_sp_1 = motor_1.readMeasuredSpeed();
	double wheel_sp_2 = motor_2.readMeasuredSpeed();
	double wheel_sp_3 = motor_3.readMeasuredSpeed();
	double wheel_sp_4 = motor_4.readMeasuredSpeed();
	double wheel_1 = wheel_sp_1 * COEFF_R;
	double wheel_2 = wheel_sp_2 * COEFF_R;
	double wheel_3 = wheel_sp_3 * COEFF_R;
	double wheel_4 = wheel_sp_4 * COEFF_R;

	if (wheel_1 != 0.0 || wheel_2 != 0.0 ||
		wheel_3 != 0.0 || wheel_4 != 0.0){
		double vx_local = (wheel_1 + wheel_2 + wheel_3 + wheel_4);
		double vy_local = (-wheel_1 + wheel_2 - wheel_3 + wheel_4);
		pose_est.pose.pose.position.x += (vx_local * cos(angle) - vy_local * sin(angle)) * SAMPLING_PERIOD;
		pose_est.pose.pose.position.y += (vx_local * sin(angle) + vy_local * cos(angle)) * SAMPLING_PERIOD;
		angle += (-wheel_1 - wheel_2 + wheel_3 + wheel_4) * COEFF_M * SAMPLING_PERIOD;
		if (angle > M_PI) angle -= M_2PI;
		else if (angle < -M_PI) angle += M_2PI;
		double temp = angle / 2;
		pose_est.pose.pose.orientation.w = cos(temp);
		pose_est.pose.pose.orientation.z = sin(temp);
	}
	pose_est.header.stamp = ros::Time::now();
	wheel_pub.publish(pose_est);
}

bool shutdownWheel(std_srvs::Empty::Request &req, std_srvs::Empty::Response &res) {
	shutdown_wheel = true;
    	return true;
}

int main(int argc, char** argv){
	ros::init(argc, argv, "mecanum_ik");
	ros::NodeHandle nh;
	ros::Rate rate(100);
	ros::Subscriber bot_vel_sub = nh.subscribe("Bot_Velocities", 1, inverse_kinematic_callback);
	wheel_pub = nh.advertise<nav_msgs::Odometry>("odom", 1000);
	ros::ServiceServer service = nh.advertiseService("shutdown_wheel", shutdownWheel);

	wiringPiSetupGpio();
	pinMode(RESET_PID_PIN, OUTPUT);
	resetWheel();

	pose_est.header.frame_id = "odom_link";

	pose_est.pose.pose.position.x = INIT_X;
	pose_est.pose.pose.position.y = INIT_Y;
	pose_est.pose.pose.position.z = 0;

	pose_est.pose.pose.orientation.x = 0;
	pose_est.pose.pose.orientation.y = 0;
	pose_est.pose.pose.orientation.z = sin(angle / 2);
	pose_est.pose.pose.orientation.w = cos(angle / 2);

	double val;
	for (int i=0; i<36; i++){
		val = 0;
		if (i == 0 || i == 7 || i == 14 || i == 21 || i == 28 || i == 35) val = 0.1;
		pose_est.pose.covariance[i] = val;
	}

	while (ros::ok() && !shutdown_wheel){
		publishPose();
		ros::spinOnce();
		rate.sleep();
	}
	digitalWrite(RESET_PID_PIN, LOW);
	return 1;
}
